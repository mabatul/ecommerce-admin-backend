# Copy to .env.local to run standalone (outside Docker). Never commit the
# result. On Railway, these same variables are set in the service's
# dashboard (Settings -> Variables), not in a file.

ENVIRONMENT=local
PROJECT_NAME=ecommerce-admin
AWS_REGION=us-east-1

# local -> http://localhost:4566 (LocalStack, see ecommerce-admin-infra)
# dev   -> URL of the DynamoDB Local service on Railway (see
#          ecommerce-admin-infra/docs/RAILWAY.md)
# prod  -> empty (real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

BACKEND_PORT=4000
