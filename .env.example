# Copy to .env.local to run standalone with `npm run dev` (outside Docker).
# Never commit the result. On Railway, these same variables are set in the
# service's dashboard (Settings -> Variables), not in a file. Running via
# `docker compose up` instead? That compose file already sets its own
# AWS_ENDPOINT_URL default (host.docker.internal) — this file's default
# below (localhost) is for the non-Docker, `npm run dev` case only.

ENVIRONMENT=local
PROJECT_NAME=ecommerce-admin
AWS_REGION=us-east-1

# npm run dev (no Docker)     -> http://localhost:4566
# docker compose up (this repo's own compose) -> http://host.docker.internal:4566
# dev (Railway)   -> URL of the DynamoDB Local service on Railway (see
#                    ecommerce-admin-infra/docs/RAILWAY.md)
# prod            -> empty (real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

BACKEND_PORT=4000

# Admin API key: admin routes require `Authorization: Bearer <key>`. Leave empty
# only in local dev (routes stay open when ENVIRONMENT=local); any other
# environment refuses admin requests until this is set.
ADMIN_API_KEY=
